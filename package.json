{
  "name": "agent-mascots",
  "version": "0.1.0",
  "description": "Animated mascots that show what your AI agent is doing. One dependency-free web component.",
  "license": "MIT",
  "author": "Kyle Oliveiro <hello@kyle.sg>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comfycomputer/agent-mascots.git"
  },
  "homepage": "https://comfycomputer.github.io/agent-mascots",
  "bugs": {
    "url": "https://github.com/comfycomputer/agent-mascots/issues"
  },
  "type": "module",
  "keywords": [
    "web-component",
    "custom-element",
    "mascot",
    "agent",
    "ai",
    "svg",
    "animation"
  ],
  "files": [
    "dist",
    "custom-elements.json",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/core.js",
    "./dist/cdn.js",
    "./dist/shapes/*.js",
    "./dist/accessories/*.js"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "customElements": "custom-elements.json",
  "unpkg": "./dist/cdn.js",
  "jsdelivr": "./dist/cdn.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./cdn": {
      "types": "./dist/index.d.ts",
      "default": "./dist/cdn.js"
    },
    "./jsx": {
      "types": "./dist/jsx.d.ts",
      "default": "./dist/jsx.js"
    },
    "./shapes/*": {
      "types": "./dist/shapes/*.d.ts",
      "default": "./dist/shapes/*.js"
    },
    "./accessories/*": {
      "types": "./dist/accessories/*.d.ts",
      "default": "./dist/accessories/*.js"
    },
    "./custom-elements.json": "./custom-elements.json",
    "./package.json": "./package.json"
  },
  "packageManager": "bun@1.4.0",
  "workspaces": [
    ".",
    "examples/react",
    "examples/vue",
    "examples/svelte",
    "examples/solid"
  ],
  "scripts": {
    "build": "bun scripts/build.mjs",
    "prepack": "bun run build",
    "prepublishOnly": "bun scripts/check-release.mjs",
    "changeset": "changeset",
    "typecheck": "bun --bun tsc --noEmit -p tsconfig.json",
    "lint": "bun --bun oxlint --deny-warnings src test scripts site",
    "pretest": "bun run build",
    "test": "bun --bun vitest run",
    "test:browser": "bun --bun playwright test",
    "test:package": "bun scripts/verify-consumers.mjs",
    "test:examples": "bun run build && bun scripts/verify-examples.mjs",
    "examples:html": "bun run build && bun --bun vite --open /examples/html/",
    "screenshots": "bun scripts/contact-sheets.mjs",
    "screenshots:simple": "bun scripts/simple-sheets.mjs",
    "bench": "bun test/perf/run.mjs",
    "site:prepare": "bun run build && bun scripts/site-metrics.mjs",
    "site": "bun run site:prepare && cd site && bun --bun vite dev",
    "site:build": "bun run site:prepare && cd site && bun --bun vite build && cd .. && bun scripts/site-budget.mjs",
    "test:site": "bun --bun playwright test --config test/site/playwright.config.ts",
    "test:perf": "bun test/site/perf.mjs",
    "size": "bun --bun size-limit"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@custom-elements-manifest/analyzer": "0.11.0",
    "@playwright/test": "1.62.1",
    "@size-limit/preset-small-lib": "14.3.0",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "lucide": "1.68.0",
    "oxlint": "1.90.0",
    "playwright": "1.62.1",
    "rolldown": "1.2.16",
    "simple-icons": "16.36.0",
    "size-limit": "14.3.0",
    "svelte": "5.57.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
